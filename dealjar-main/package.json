{
  "name": "dealjar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Every deal fills a savings jar. A deals and savings mini app for Nimiq Pay.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production tsx --env-file-if-exists=.env.local server/index.ts",
    "cron": "tsx --env-file-if-exists=.env.local server/cron.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:api": "tsx scripts/test-api.mts",
    "test:browser": "node scripts/test-browser.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@electric-sql/pglite": "^0.5.15",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^2.1.6",
    "@nimiq/core": "^2.23.0",
    "@nimiq/mini-app-sdk": "^0.2.5",
    "@tanstack/react-query": "^5.107.1",
    "cross-env": "^10.1.0",
    "drizzle-orm": "^0.45.4",
    "gsap": "^3.15.1",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "lucide-react": "^1.70.0",
    "matter-js": "^0.20.0",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
